        "config_entry_id": {
          "name": "SparkyFitness account"
        },
        "date": {
          "name": "Date (default: today)"
        },
        "category_id": {
          "name": "Category UUID"
        },
        "value": {
          "name": "Value in category unit"
        },
        "hour": {
          "name": "Local hour (hourly category)"
        }
      }
    },
    "record_water": {
      "name": "Record water intake",
      "description": "Record a water sample in mL. Reuse record_id only to correct that same sample; use a new ID for each drink.",
      "fields": {
        "config_entry_id": {
          "name": "SparkyFitness account"
        },
        "date": {
          "name": "Date (default: today)"
        },
        "amount_ml": {
          "name": "Water (mL)"
        },
        "record_id": {
          "name": "Stable sample ID"
        }
      }
    },
    "record_sleep": {
      "name": "Record sleep",
      "description": "Record bedtime and wake time with UTC offsets. No invented sleep stages or score. Check SparkyFitness before resubmitting.",
      "fields": {
        "config_entry_id": {
          "name": "SparkyFitness account"
        },
        "date": {
          "name": "Date (default: today)"
        },
        "bedtime": {
          "name": "Bedtime (ISO, with UTC offset)"
        },
        "wake_time": {
          "name": "Wake time (ISO, with UTC offset)"
        }
      }
    },
